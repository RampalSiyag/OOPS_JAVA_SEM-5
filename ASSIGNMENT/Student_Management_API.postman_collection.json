{
  "info": {
    "name": "Student Management API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" }
  ],
  "item": [
    {
      "name": "Add student",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/api/students", "host": ["{{baseUrl}}"], "path": ["api", "students"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Aarav Sharma\",\n  \"email\": \"aarav@example.com\",\n  \"course\": \"Computer Science\",\n  \"age\": 20\n}"
        }
      }
    },
    {
      "name": "Get all students",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/api/students", "host": ["{{baseUrl}}"], "path": ["api", "students"] }
      }
    },
    {
      "name": "Get student by ID",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/api/students/1", "host": ["{{baseUrl}}"], "path": ["api", "students", "1"] }
      }
    },
    {
      "name": "Update student",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/api/students/1", "host": ["{{baseUrl}}"], "path": ["api", "students", "1"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Aarav Sharma\",\n  \"email\": \"aarav@example.com\",\n  \"course\": \"Data Science\",\n  \"age\": 21\n}"
        }
      }
    },
    {
      "name": "Get students by course",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/api/students/course/Data Science", "host": ["{{baseUrl}}"], "path": ["api", "students", "course", "Data Science"] }
      }
    },
    {
      "name": "Delete student",
      "request": {
        "method": "DELETE",
        "url": { "raw": "{{baseUrl}}/api/students/1", "host": ["{{baseUrl}}"], "path": ["api", "students", "1"] }
      }
    },
    {
      "name": "Get student - not found (404)",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/api/students/9999", "host": ["{{baseUrl}}"], "path": ["api", "students", "9999"] }
      }
    },
    {
      "name": "Add student - validation error (400)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/api/students", "host": ["{{baseUrl}}"], "path": ["api", "students"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"\",\n  \"email\": \"not-an-email\",\n  \"course\": \"\",\n  \"age\": -5\n}"
        }
      }
    }
  ]
}
